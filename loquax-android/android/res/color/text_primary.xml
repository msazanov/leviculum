<?xml version="1.0" encoding="utf-8"?>
<!-- The theme's primary text: a plain colour would keep a disabled button's
     label as bright as an enabled one. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/text" android:alpha="0.38" />
    <item android:color="@color/text" />
</selector>
