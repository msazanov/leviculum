<?xml version="1.0" encoding="utf-8"?>
<!-- The light theme; values-night/themes.xml is the dark one. Android picks
     by the phone's dark setting (the -night qualifier, which every API level
     we run on resolves), and recreates a visible screen when it changes. -->
<resources>
    <style name="Loquax" parent="@android:style/Theme.DeviceDefault.Light.DarkActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
</resources>
