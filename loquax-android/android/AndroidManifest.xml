<?xml version='1.0'?>
<manifest xmlns:a='http://schemas.android.com/apk/res/android'
          package='{{PACKAGE_NAME}}'
          a:versionCode='{{VERSION_CODE}}'
          a:versionName='{{VERSION_NAME}}'>

  <uses-sdk a:minSdkVersion='{{MIN_SDK}}' a:targetSdkVersion='{{TARGET_SDK}}'/>

  <!-- The one TCP connection to the home node. -->
  <uses-permission a:name='android.permission.INTERNET'/>
  <!-- The service that holds the session in the background (LoquaxService). -->
  <uses-permission a:name='android.permission.FOREGROUND_SERVICE'/>
  <uses-permission a:name='android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING'/>
  <!-- Its notifications: a run time question from Android 13 on (Asks). -->
  <uses-permission a:name='android.permission.POST_NOTIFICATIONS'/>
  <!-- The battery optimisation exemption, asked once and never forced (Asks). -->
  <uses-permission a:name='android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS'/>

  <application a:label='@string/app_name'
               a:icon='@android:drawable/sym_def_app_icon'
               a:theme='@style/Loquax'>
    <!-- Light or dark by the phone's setting (res/values-night). A change
         while a screen is open recreates it, as a rotation does; the
         session lives in LoquaxService and the library, not in a screen,
         so no configChanges='uiMode' is declared. -->

    <activity a:name='network.leviculum.loquax.MainActivity' a:exported='true'>
      <intent-filter>
        <category a:name='android.intent.category.LAUNCHER'/>
        <action a:name='android.intent.action.MAIN'/>
      </intent-filter>
      <!-- A home code shared from another app, a QR reader's for one. -->
      <intent-filter>
        <action a:name='android.intent.action.SEND'/>
        <category a:name='android.intent.category.DEFAULT'/>
        <data a:mimeType='text/plain'/>
      </intent-filter>
    </activity>

    <activity a:name='network.leviculum.loquax.ConversationsActivity' a:exported='false'/>

    <activity a:name='network.leviculum.loquax.ChatActivity'
              a:exported='false'
              a:windowSoftInputMode='adjustResize'/>

    <activity a:name='network.leviculum.loquax.MapActivity' a:exported='false'/>

    <service a:name='network.leviculum.loquax.LoquaxService'
             a:exported='false'
             a:foregroundServiceType='remoteMessaging'/>

  </application>
</manifest>
